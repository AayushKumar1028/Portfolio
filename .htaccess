# Generated by build.js — do not edit. Apache/cPanel counterpart to
# vercel.json: serves the extensionless URLs the links and canonical tags
# use, and shows the styled 404 page on unknown paths.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files (styles.css, favicon.svg, …) and directories are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # projects → projects.html, about → about.html, and so on.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]
</IfModule>

ErrorDocument 404 /portfolio/404.html
