# Copy to backend/.env and edit. Every value here is optional — the app runs
# with defaults and falls back gracefully when something is missing.

# ------------------------------------------------------------------ GitHub
# Account whose public repositories are shown on the Projects page.
GITHUB_USERNAME=Aayush01

# Optional personal access token (no scopes needed for public data).
# Raises the unauthenticated limit of 60 requests/hour to 5000.
GITHUB_TOKEN=

# How long a fetched GitHub response is reused before hitting the API again.
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------- server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --------------------------------------------------------------- contact
# Where contact-form messages are delivered.
CONTACT_TO=kumarkids.aayush@gmail.com

# Leave SMTP_HOST empty to skip email delivery: the form then opens a
# pre-filled draft in the visitor's mail client instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
