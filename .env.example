# Copy to .env for local builds. Both values are read by build.js to fill in
# the canonical tags, robots.txt, sitemap.xml and every internal href/src.
# Entirely optional: on Vercel the domain is detected from the deployment and
# the site deploys at the root, so you only need these to pin things yourself.

# The public URL of the site (canonical/og:url/sitemap use it).
# VITE_SITE_URL=https://example.com

# The path the build is hosted under, when it is NOT at the domain root —
# e.g. "portfolio" for https://aayushkumar.ca/portfolio/. Leave unset for a
# root deploy (as on Vercel). Fill __SITE_BASE__ in every internal link and
# generates an .htaccess that serves the extensionless URLs on Apache/cPanel.
# VITE_SITE_BASE=portfolio
